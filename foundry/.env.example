# Public Supabase browser values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Postgres connection. Use the Supabase pooled/direct connection string.
DATABASE_URL=
# Optional alias if your platform supplies this name.
SUPABASE_DB_URL=

# 32-byte key encoded as base64 or 64 hex chars. Generate with: openssl rand -base64 32
FOUNDRY_SECRET_ENCRYPTION_KEY=

# Provider keys stay server-side. Set only the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional one-time bootstrap for the Tunneling bridge integration.
FOUNDRY_TUNNELING_URL=
FOUNDRY_TUNNELING_TOKEN=
FOUNDRY_TUNNELING_TRANSPORT=streamable_http
FOUNDRY_TUNNELING_NAME=Primary Roblox bridge

# Read-only bridge preview is automatic in `next dev` when the two values above are set.
# In production it stays disabled unless this is explicitly "true". Only enable for a
# deliberately public, read-only bridge status surface; the token is never sent to the browser.
# FOUNDRY_PUBLIC_BRIDGE_PREVIEW=true

# Only enable on the persistent worker/local connector host, never on Vercel.
FOUNDRY_ALLOW_LOCAL_CONNECTOR=false
FOUNDRY_STDIO_COMMAND=python3
FOUNDRY_STDIO_ARGS=mcp_server.py,--no-embedded
FOUNDRY_STDIO_CWD=../roblox-bridge

# Worker tuning
FOUNDRY_WORKER_ID=foundry-worker-1
FOUNDRY_WORKER_POLL_MS=1000
FOUNDRY_JOB_LEASE_SECONDS=90

# Optional owner id for the CLI seed script.
FOUNDRY_OWNER_ID=

# Verification scripts use a real local or named-tunnel bridge.
FOUNDRY_TEST_BRIDGE_URL=http://127.0.0.1:8077
FOUNDRY_TEST_BRIDGE_TOKEN=
